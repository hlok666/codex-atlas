<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/atlas_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/atlas_widget_background"
    android:clickable="true"
    android:focusable="true"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/atlas_widget_brand"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans"
            android:text="CODEX ATLAS"
            android:textColor="#526352"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/atlas_widget_balance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Balance unavailable"
            android:textColor="#6B9B70"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/atlas_widget_state_dot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="●"
            android:textColor="#D3A941"
            android:textSize="18sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:background="@drawable/atlas_screen"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/atlas_widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="No active session"
            android:textColor="#BFE7B8"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/atlas_widget_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="idle"
            android:textColor="#8AA18B"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/atlas_widget_output"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="top"
            android:maxLines="5"
            android:text="Waiting for Codex output"
            android:textColor="#A7C1A8"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/atlas_widget_activate"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/atlas_action_background"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="激活会话"
            android:textColor="#2F7C3B"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/atlas_widget_continue"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:background="@drawable/atlas_action_background"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="输入继续"
            android:textColor="#2F7C3B"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/atlas_widget_reply"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:background="@drawable/atlas_action_background"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="回复"
            android:textColor="#2F7C3B"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
